LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Router-only (OpenRouter): pin the backend so a benchmark round cannot silently mix
# providers/quantizations. Comma-separated, e.g. DeepInfra. Blank = router chooses.
LLM_PROVIDER_ORDER=
LLM_PROVIDER_ALLOW_FALLBACKS=false
# Optional, e.g. fp8 -- pin the quantization when one provider serves several.
LLM_PROVIDER_QUANTIZATION=
GRIBSTREAM_API_KEY=
